from datetime import datetime
class Calculator:
    def __init__(self):
        self.history = []
    def add(self, a, b):
        c = a + b
        self.history.append(f"{a} + {b} = {c}")
        return c
    def multiply(self, a, b):
        c = a * b
        self.history.append(f"{a} * {b} = {c}")
        return c
    def divide(self, a, b):
        c = a / b
        self.history.append(f"{a} / {b} = {c}")
        return c
    def save(self):
        with open("history.txt", "w") as a:
            for b in self.history:
                a.write(f"{datetime.now()} | {b}\n")
